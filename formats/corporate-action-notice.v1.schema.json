{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iomarkets.org/formats/corporate-action-notice.v1.schema.json",
  "title": "Corporate action notice, version 1",
  "description": "A dividend, split, reverse split or merger stated as JSON-LD that an issuer embeds in its own announcement or investor relations page (inside <script type=\"application/ld+json\">), so AI engines, agents and data vendors read the dates and amounts instead of guessing them from prose. Dates are YYYY-MM-DD. Uses schema.org for the issuer and an inline context for the rest, so no context file has to be fetched.",
  "$comment": "Released under CC0 1.0 Universal (public domain): https://creativecommons.org/publicdomain/zero/1.0/. Governed by IoMarkets.org: https://iomarkets.org/formats",
  "type": "object",
  "additionalProperties": false,
  "required": ["@context", "@type", "conformsTo", "eventType", "isoEventCode", "issuer", "announced"],
  "properties": {
    "@context": {
      "type": "array",
      "minItems": 2,
      "description": "[\"https://schema.org\", { \"ioca\": \"https://iomarkets.org/formats/corporate-action-notice#\", \"CorporateActionNotice\": \"ioca:CorporateActionNotice\" }]"
    },
    "@type": { "const": "CorporateActionNotice" },
    "conformsTo": { "const": "https://iomarkets.org/formats/corporate-action-notice.v1.schema.json" },
    "eventType": { "enum": ["dividend", "split", "reverse-split", "merger"] },
    "isoEventCode": { "enum": ["DVCA", "SPLF", "SPLR", "MRGR"], "description": "The ISO 20022 / ISO 15022 event code, as in seev.031." },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["@type", "name"],
      "properties": {
        "@type": { "const": "Corporation" },
        "name": { "type": "string", "minLength": 1 },
        "tickerSymbol": { "type": "string", "minLength": 1 },
        "identifier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["@type", "propertyID", "value"],
          "properties": {
            "@type": { "const": "PropertyValue" },
            "propertyID": { "const": "SEC CIK" },
            "value": { "type": "string", "pattern": "^\\d{10}$" }
          }
        }
      }
    },
    "security": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "figi": { "type": "string", "pattern": "^BBG[0-9A-Z]{9}$" },
        "ticker": { "type": "string", "minLength": 1 },
        "instrument": { "const": "ADS", "description": "When the amounts and dates are per American depositary share." }
      }
    },
    "announced": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "exDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "recordDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "paymentDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "effectiveDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "cash": {
      "type": "object",
      "additionalProperties": false,
      "required": ["amount", "currency"],
      "properties": {
        "amount": { "type": "string", "pattern": "^\\d+(\\.\\d+)?$", "description": "Per share (or per ADS), as a decimal string so no precision is lost." },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217." }
      }
    },
    "ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["new", "old"],
      "properties": {
        "new": { "type": "number", "exclusiveMinimum": 0 },
        "old": { "type": "number", "exclusiveMinimum": 0 }
      },
      "description": "Shares after : shares before, for a split; acquirer shares per share, for a stock merger."
    },
    "frequency": { "enum": ["monthly", "quarterly", "semi-annual", "annual", "special", "other"] },
    "acquirer": { "type": "string", "minLength": 1 },
    "source": { "type": "string", "pattern": "^https://", "description": "The regulatory filing the notice restates." }
  }
}
